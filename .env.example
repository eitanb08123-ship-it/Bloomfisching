# Which avatar-video provider adapter to use.
# "did" calls the real D-ID API (needs DID_API_KEY below).
# "mock" simulates generation locally with no API calls - handy for UI dev.
AVATAR_PROVIDER=did

# D-ID API key (get one free at https://studio.d-id.com/account-settings).
# It is copied from the dashboard already in "username:password" form -
# paste it exactly as given, the server base64-encodes it for you.
DID_API_KEY=

# Optional: override the D-ID API base URL (useful for testing/mocking).
DID_API_BASE_URL=https://api.d-id.com

# Optional: generation rate limit, per IP address.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=3600000
