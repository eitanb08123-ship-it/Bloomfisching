# Required: your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=paste-your-key-here

# --- Optional overrides (defaults shown) ---

# Gemini model to use for replies
# GEMINI_MODEL=gemini-flash-latest

# Max tokens Gemini may generate per reply
# MAX_REPLY_TOKENS=1024

# How many recent messages (user + model) to keep per contact for context
# MAX_HISTORY_MESSAGES=15

# Where conversation history / pause state is persisted (JSON file)
# DATA_FILE=./data/state.json

# Whether the bot should auto-reply inside group chats too
# RESPOND_TO_GROUPS=false

# Wait this long (ms) after the last message in a chat before replying,
# so a burst of quick texts gets answered as one reply instead of several
# DEBOUNCE_MS=1500

# Simulated "typing" delay bounds (ms) before a reply is actually sent
# MIN_TYPING_DELAY_MS=1200
# MAX_TYPING_DELAY_MS=6000
# MS_PER_CHAR_TYPING=40

# Max Gemini API calls in flight at once (extra requests queue)
# MAX_CONCURRENT_CALLS=3

# Retry behavior for transient Gemini API failures (rate limits, 5xx, network)
# MAX_RETRIES=3
# RETRY_BASE_DELAY_MS=1000

# Reconnect backoff for the WhatsApp Web connection
# RECONNECT_BASE_DELAY_MS=3000
# MAX_RECONNECT_DELAY_MS=60000

# Send a graceful fallback message if Gemini fails after all retries
# SEND_FAILURE_MESSAGE=true
# FAILURE_MESSAGE=Sorry, I'm having trouble replying right now — please try again in a moment.

# Override the bot's persona/system prompt entirely (see config.js for the default)
# SYSTEM_PROMPT=

# Port the local setup UI (npm run setup) listens on
# SETUP_UI_PORT=3000

# --- Instagram (optional) — leave all four blank to skip Instagram entirely ---
# See the README's "Instagram setup" section for the full walkthrough
# (Meta App, linking your Instagram account, and exposing the webhook with ngrok).

# Page access token for the Facebook Page linked to your Instagram account
# IG_PAGE_ACCESS_TOKEN=

# Your Meta App's secret (Settings > Basic) — verifies webhook requests are really from Meta
# IG_APP_SECRET=

# A password you make up yourself; must match what you enter in the Meta webhook setup screen
# IG_VERIFY_TOKEN=

# Port the Instagram webhook server listens on locally (point your tunnel, e.g. ngrok, at this)
# IG_WEBHOOK_PORT=3001

# Graph API version used for Instagram requests — bump this if Meta requires a newer one
# IG_GRAPH_API_VERSION=v21.0
