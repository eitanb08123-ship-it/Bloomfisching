# Required: your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=paste-your-key-here

# --- Optional overrides (defaults shown) ---

# Gemini model to use for replies
# GEMINI_MODEL=gemini-flash-latest

# Max tokens Gemini may generate per reply
# MAX_REPLY_TOKENS=1024

# How many recent messages (user + model) to keep per contact for context
# MAX_HISTORY_MESSAGES=15

# Where conversation history / pause state is persisted (JSON file)
# DATA_FILE=./data/state.json

# Whether the bot should auto-reply inside group chats too
# RESPOND_TO_GROUPS=false

# Wait this long (ms) after the last message in a chat before replying,
# so a burst of quick texts gets answered as one reply instead of several
# DEBOUNCE_MS=1500

# Simulated "typing" delay bounds (ms) before a reply is actually sent
# MIN_TYPING_DELAY_MS=1200
# MAX_TYPING_DELAY_MS=6000
# MS_PER_CHAR_TYPING=40

# Max Gemini API calls in flight at once (extra requests queue)
# MAX_CONCURRENT_CALLS=3

# Retry behavior for transient Gemini API failures (rate limits, 5xx, network)
# MAX_RETRIES=3
# RETRY_BASE_DELAY_MS=1000

# Reconnect backoff for the WhatsApp Web connection
# RECONNECT_BASE_DELAY_MS=3000
# MAX_RECONNECT_DELAY_MS=60000

# Send a graceful fallback message if Gemini fails after all retries
# SEND_FAILURE_MESSAGE=true
# FAILURE_MESSAGE=Sorry, I'm having trouble replying right now — please try again in a moment.

# Override the bot's persona/system prompt entirely (see config.js for the default)
# SYSTEM_PROMPT=

# Port the local setup UI (npm run setup) listens on
# SETUP_UI_PORT=3000

# --- Instagram (optional) — leave both blank to skip Instagram entirely ---
# UNOFFICIAL: logs in directly with your real username/password (not Meta's official API).
# This carries a real risk of the account being flagged or restricted — read the README's
# "Instagram setup" section before filling these in. Use an account you're prepared to lose,
# ideally not your main one.

# Your Instagram username
# IG_USERNAME=

# Your Instagram password
# IG_PASSWORD=

# How often (ms) to check Instagram for new DMs — lower feels faster but is more likely to
# draw attention as automated behavior; higher is slower to reply but less conspicuous
# IG_POLL_INTERVAL_MS=15000

# Where the logged-in Instagram session is cached, so the bot doesn't log in fresh every
# restart (repeated logins are themselves a red flag for automation)
# IG_SESSION_FILE=./data/instagram-session.json

# Where the "already replied to" bookkeeping per conversation is stored
# IG_SEEN_FILE=./data/instagram-seen.json

# The login library claims to be a specific Instagram app version; Instagram's servers reject
# clearly-outdated ones ("Your version of Instagram is out of date"). These defaults are a
# best-effort bump, not a verified-current pair. If login still reports the app as out of
# date, check Settings -> About in your own Instagram app for the current version number and
# set IG_APP_VERSION to that (IG_APP_VERSION_CODE has no in-app equivalent to check).
# IG_APP_VERSION=381.0.0.32.153
# IG_APP_VERSION_CODE=667813267
